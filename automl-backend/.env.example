# Groq API Configuration
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=sqlite:///./automl.db

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# File Upload
MAX_UPLOAD_SIZE_MB=100

# Job Management
JOB_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_JOBS=5
